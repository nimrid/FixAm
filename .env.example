# API key: MODEL_API_KEY is canonical; META_MODEL_API_KEY is also accepted.
# Set the SAME name in Vercel (Project > Settings > Environment Variables).
MODEL_API_KEY=
META_MODEL_API_BASE=https://api.meta.ai/v1
# Confirmed model IDs from docs
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_SAM=sam-3.1
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_TRANSCRIBE=muse-voice-transcribe-1.0

# "true" = local mocks, no API spend. "false" = live Meta API calls.
FIXAM_DEMO_MODE=false

# Modal pipeline: deploy with `modal deploy modal_app.py`.
# Secret must match FIXAM_MODAL_SECRET at deploy time.
FIXAM_MODAL_SECRET=
# Option A (simplest): paste ANY one deployed Modal endpoint URL here.
# Sibling endpoints (submit-clip, clip-result, report-price,
# community-prices) are derived by swapping the function slug in the host.
MODAL_VIDEO_URL=
# Option B (explicit, wins over derivation): set any that you need.
# MODAL_SUBMIT_CLIP_URL=
# MODAL_CLIP_RESULT_URL=
# MODAL_REPORT_PRICE_URL=
# MODAL_COMMUNITY_PRICES_URL=

# After deploy, open GET /api/health to confirm demo vs configured
# (it never prints secret values and never calls a model).
